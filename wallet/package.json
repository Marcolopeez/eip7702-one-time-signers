{
  "name": "one-time-key-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:extension": "wxt prepare && tsc --noEmit -p tsconfig.extension.json",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:extension",

    "prepare:init": "tsx src/apps/cli/commands/init/prepareLocalInit.ts",
    "state:init": "tsx src/apps/cli/commands/init/createInitialState.ts",
    "sync": "tsx src/apps/cli/commands/sync.ts",

    "execute:set-number": "tsx src/apps/cli/commands/operations/executeSetNumber.ts",
    "execute:target-revert": "tsx src/apps/cli/commands/operations/executeTargetRevert.ts",
    "execute:expired-set-number": "tsx src/apps/cli/commands/operations/executeExpiredSetNumber.ts",
    "execute:invalid-next-auth": "tsx src/apps/cli/commands/dev/executeInvalidNextAuth.ts",
    
    "recover": "tsx src/apps/cli/commands/recovery/recover.ts",
    
    "derive:demo": "tsx src/apps/cli/commands/dev/deriveDemo.ts",
    "sign:demo": "tsx src/apps/cli/commands/dev/sign-Demo.ts",
    
    "extension:dev": "wxt",
    "extension:build": "wxt build",
    "extension:zip": "wxt zip"
  },
  "dependencies": {
    "@noble/hashes": "latest",
    "@scure/bip32": "latest",
    "@scure/bip39": "latest",
    "viem": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@wxt-dev/module-react": "latest",
    "wxt": "latest"
  }
}
